{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trocado",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "r2_buckets": [
    { "binding": "RECEIPTS", "bucket_name": "trocado-receipts" }
  ],
  "vars": {
    "SUPABASE_URL": "https://cgltkzbdnnzljfldvqwi.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_hr9iItq-rcj3k2TeDJKChg_p8C65P2H",
    "AI_GATEWAY_ID": "trocado",
    "RECEIPTS_ENABLED": "true",
    "AI_DAILY_LIMIT_PER_USER": "60"
  }
}
